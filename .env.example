# ──────────────────────────────────────────────
# 이 키는 서버(프록시)에서만 사용되며, 브라우저로는 절대 노출되지 않습니다.
#
# [프로덕션 배포]
#   Vercel 대시보드 → Project Settings → Environment Variables
#   에서 GEMINI_API_KEY 를 등록하세요. (.env 파일은 배포되지 않습니다)
#
# [로컬 개발]
#   이 파일을 .env 로 복사한 뒤 키를 입력하고 `vercel dev` 로 실행하세요.
#     cp .env.example .env
#   .env 는 .gitignore 에 등록되어 커밋되지 않습니다.
#
# 키 발급: https://aistudio.google.com/apikey  (AIzaSy... 형식)
# ──────────────────────────────────────────────

GEMINI_API_KEY=

# ──────────────────────────────────────────────
# 선생님 계정 / 학생 코드 기능에 사용하는 저장소(Upstash Redis).
#
# [설정 방법]
#   Vercel 대시보드 → Storage 탭 → Marketplace Database Providers →
#   "Upstash" 선택 후 Redis 생성 →
#   프로젝트에 연결(Development/Preview/Production 전체)하면
#   아래 두 값이 자동으로 프로젝트 환경변수에 등록됩니다.
#   (예전 "Vercel KV"는 지금은 Upstash 마켓플레이스 통합으로 대체되었습니다)
#
# [로컬 개발]
#   `vercel link` 로 프로젝트를 연결한 뒤
#   `vercel env pull .env.local` 로 이 값들을 받아오세요.
#   (별도의 로컬 에뮬레이터는 없어서 실제 Redis 스토어에 접속합니다)
# ──────────────────────────────────────────────

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
